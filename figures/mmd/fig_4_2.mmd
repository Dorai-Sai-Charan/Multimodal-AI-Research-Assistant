flowchart TD
    PDF(["📄  PDF Upload"])

    subgraph EXTRACT["  Extraction Processors  "]
        direction LR
        P1["① PDFProcessor\nPyMuPDF\nText + headings\nfont ≥ 14pt or keyword"]
        P2["② TableExtractor\npdfplumber\nBorders → Markdown\nraw cells preserved"]
        P3["③ ImageExtractor\nPyMuPDF\nSave PNG/JPEG\nfilter < 50×50 px"]
        P4["④ OCRProcessor\nEasyOCR\nScanned text\nconfidence score"]
        P5["⑤ VisionAnalyzer\nGemini 2.0 Flash\nFigure descriptions\n4 s rate limit"]
        P6["⑥ EquationExtractor\nGemini Vision\nImage → LaTeX\n+ explanation"]
    end

    subgraph CHUNK["  Chunking & Embedding  "]
        direction LR
        P7["⑦ SemanticChunker\nText: 512 chars · 50 overlap\nTable/Fig/Eq: single chunk\nUUID4 per chunk"]
        P8["📐  EmbeddingService\nall-MiniLM-L6-v2\n384-dim · L2-normalised\nbatch = 32"]
    end

    OUT(["🗄️  ChromaDB + SQLite\nDocument status → completed"])

    PDF --> EXTRACT --> CHUNK --> OUT

